			<img class="auth-page-logo" width="56" height="56" src="{{AssetUrlPrefix}}/img/logo.svg" alt="" aria-hidden="true">
			{{template "user/auth/signin_inner" .}}
		</div>
	</div>
</div>
{{template "base/footer" .}}
